{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChargingSession",
  "type": "object",
  "required": ["session_id", "vehicle_id", "connector_id", "energy_kwh", "duration_s", "status"],
  "additionalProperties": false,
  "properties": {
    "session_id": { "type": "string", "pattern": "^EPD-[0-9]{5}$" },
    "vehicle_id": { "type": "string", "minLength": 1 },
    "connector_id": { "type": "integer", "minimum": 1, "maximum": 8 },
    "energy_kwh": { "type": "number", "minimum": 0, "maximum": 150 },
    "duration_s": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "status": { "type": "string", "enum": ["completed", "interrupted", "error"] }
  }
}
