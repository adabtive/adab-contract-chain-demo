{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aggregated_window.json",
  "type": "object",
  "properties": {
    "sensor_id":      { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "measurement_type": {
      "type": "string",
      "enum": ["air_quality", "climate", "noise"]
    },
    "window_start":   { "type": "string", "format": "date-time" },
    "window_end":     { "type": "string", "format": "date-time" },
    "sample_count":   { "type": "integer", "minimum": 1 },
    "stats": {
      "type": "object",
      "properties": {
        "mean":    { "type": "number" },
        "std_dev": { "type": "number", "minimum": 0 },
        "min":     { "type": "number" },
        "max":     { "type": "number" }
      },
      "required": ["mean", "std_dev", "min", "max"],
      "additionalProperties": false
    },
    "metric": {
      "type": "string"
    }
  },
  "required": ["sensor_id", "measurement_type", "window_start", "window_end", "sample_count", "stats", "metric"],
  "additionalProperties": false
}
